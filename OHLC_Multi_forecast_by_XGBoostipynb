    "df= yf.download('VIVO', period='max', interval='1d', multi_level_index=False)\n",
    "df=df.reset_index()\n",
    "#df['Datetime'] = pd.to_datetime(df['Datetime']).dt.tz_localize(None)\n",
    "df.set_index('Date', inplace=True)\n",
    "df=df.sort_index()\n",
    "df.tail(1)"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "920a93e8-cb48-4419-8938-0469a685684a",
   "metadata": {},
   "source": [
    "### Indicators"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 707,
   "id": "47a5f527-c8bb-4f6b-9baf-f1827813bccb",
   "metadata": {},
   "outputs": [],
   "source": [
    "# Indicators\n",
    "df['ema10'] = df.High.ewm(min_periods=10, span=10).mean()\n",
    "df['ema12'] = df.Close.ewm(min_periods=12, span=12).mean()\n",
    "df['ema20'] = df.Close.ewm(min_periods=20, span=20).mean()\n",
    "df['ema26'] = df.Close.ewm(min_periods=26, span=26).mean()\n",
    "df['ema50'] = df.Close.ewm(min_periods=50, span=50).mean()\n",
    "df['ema200'] = df.Close.ewm(min_periods=200, span=200).mean()\n",
    "df['MACD'] = df['ema26'] - df['ema12']\n",
    "df['MACD_signal']=df.MACD.ewm(min_periods=9, span=9).mean()"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "35cebf71-2eb3-4973-82b1-5f16df128e94",
   "metadata": {},
   "source": [
    "### test and train split"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 708,
   "id": "9eae066b-299d-412b-8284-0843dc0e6258",
   "metadata": {},
   "outputs": [],
   "source": [
    "df=df.dropna()\n",
    "split = int(len(df) * 0.8)\n",
    "train = df.iloc[:split]\n",
    "test = df.iloc[split:]"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 709,
   "id": "89e56f71-de43-4f83-9337-f381ce79ae8c",
   "metadata": {},
