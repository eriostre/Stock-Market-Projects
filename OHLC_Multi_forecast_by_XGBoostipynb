   "source": [
    "### Feature Engineering"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 622,
   "id": "0b5bf57c-cd20-47de-9043-b5a1d4408a67",
   "metadata": {},
   "outputs": [],
   "source": [
    "# target feature\n",
    "target1='Open'\n",
    "target2='High'\n",
    "target3='Close'\n",
    "target4='Low'"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 82,
   "id": "18ad9191-949f-49f8-b1af-55517495e644",
   "metadata": {},
   "outputs": [],
   "source": [
    "# exogenous variables\n",
    "exogenous=['ema10','ema20','ema12','ema26','ema50','ema200','MACD','MACD_signal']"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 710,
   "id": "e8d719b0-0668-43cf-87c6-9e6765842532",
   "metadata": {
    "scrolled": true
   },
   "outputs": [],
   "source": [
    "# test 1 and train 1\n",
    "train1=train[[target1]]\n",
    "test1=test[[target1]]\n",
    "# test 2 and train 2\n",
    "train2=train[[target2]]\n",
    "test2=test[[target2]]\n",
    "# test 3 and train 3\n",
    "train3=train[[target3]]\n",
    "test3=test[[target3]]\n",
    "# test 4 and train 4\n",
    "train4=train[[target4]]\n",
    "test4=test[[target4]]"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "284baa19-b203-4e12-94a6-8d9434b147c2",
   "metadata": {},
   "source": [
    "### Making lags features"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 625,
   "id": "18848a86-b429-46d4-a75b-bf2680e0d605",
   "metadata": {},
   "outputs": [],
   "source": [
    "def make_lags(data):\n",
    "    for col in data:\n",
    "        for lag in range(1,31):\n",
    "            data[f'{col}_lag{lag}']=data[col].shift(lag)\n",
    "    return data"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 711,
   "id": "982adebb-c5b1-401e-8630-07fb21710502",
   "metadata": {
    "scrolled": true
   },
   "outputs": [],
   "source": [
    "# Lags for target 1\n",
    "train1= make_lags(train1).dropna()\n",
    "test1=make_lags(test1).dropna()\n",
    "# Lags for target 2\n",
    "train2= make_lags(train2).dropna()\n",
    "test2=make_lags(test2).dropna()\n",
    "# Lags for target 3\n",
    "train3= make_lags(train3).dropna()\n",
    "test3=make_lags(test3).dropna()\n",
    "# Lags for target 4\n",
    "train4= make_lags(train4).dropna()\n",
    "test4=make_lags(test4).dropna()"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "22fc8db6-7be4-45c1-b771-9860fd070f86",
   "metadata": {},
   "source": [
    "### X_train and y_train"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 712,
   "id": "1ccaa9a4-6fab-444a-b41c-3476da8e099c",
   "metadata": {},
   "outputs": [],
   "source": [
    "# X_train, X_test, y_train, y_test for target 1\n",
    "X_train1, y_train1 = train1.iloc[:,1:],train1[target1]\n",
    "X_test1, y_test1 = test1.iloc[:,1:], test1[target1]\n",
    "# X_train, X_test, y_train, y_test for target 2\n",
    "X_train2, y_train2 = train2.iloc[:,1:],train2[target2]\n",
    "X_test2, y_test2 = test2.iloc[:,1:], test2[target2]\n",
    "# X_train, X_test, y_train, y_test for target 3\n",
    "X_train3, y_train3 = train3.iloc[:,1:],train3[target3]\n",
    "X_test3, y_test3 = test3.iloc[:,1:], test3[target3]\n",
    "# X_train, X_test, y_train, y_test for target 4\n",
    "X_train4, y_train4 = train4.iloc[:,1:],train4[target4]\n",
    "X_test4, y_test4 = test4.iloc[:,1:], test4[target4]"
   ]
  },
  {
