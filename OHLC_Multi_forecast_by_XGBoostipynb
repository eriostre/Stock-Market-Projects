   "source": [
    "### Best Parameters"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 666,
   "id": "a3f5e4d2-861a-4fc3-9e14-759eecd929f3",
   "metadata": {},
   "outputs": [],
   "source": [
    "#range of parameters\n",
    "param_range = {\n",
    "    'n_estimators': randint(100, 2000),\n",
    "    \"learning_rate\": loguniform(0.001, 0.3),\n",
    "    'max_depth': randint(3, 12),\n",
    "    \"gamma\": loguniform(1e-8, 10),\n",
    "    \"min_child_weight\": loguniform(0.01, 20),\n",
    "    'subsample': uniform(0.5, 0.5),\n",
    "    'colsample_bytree': uniform(0.5, 0.5),\n",
    "    \"colsample_bylevel\": uniform(0.5, 0.5),\n",
    "    \"colsample_bynode\": uniform(0.5, 0.5),\n",
    "    \"reg_alpha\": loguniform(1e-8, 10),                 \n",
    "    \"reg_lambda\": loguniform(1e-8, 10),\n",
    "    \"max_bin\": randint(128, 512),\n",
    "    \"grow_policy\": [\"depthwise\", \"lossguide\"],\n",
    "    \"max_leaves\": randint(0, 256),\n",
    "    \"tree_method\": [\"gpu_hist\"],\n",
    "}"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 667,
   "id": "2c6a2757-4e6d-4185-a9d0-55058b3f012c",
   "metadata": {},
   "outputs": [],
   "source": [
    "model = XGBRegressor(\n",
    "    objective=\"reg:squarederror\",\n",
    "    random_state=42,\n",
    "    n_jobs=-1\n",
    ")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 669,
   "id": "4c6631b5-23aa-4a6d-bae4-46e214d2afeb",
   "metadata": {},
   "outputs": [],
   "source": [
    "#RandomizedSearchCV\n",
    "search = RandomizedSearchCV(\n",
    "    estimator=model,\n",
    "    param_distributions=param_range,\n",
    "    n_iter=60,                    \n",
    "    scoring=\"neg_root_mean_squared_error\", \n",
    "    cv=5,\n",
    "    verbose=3,\n",
    "    n_jobs=-1\n",
    ")"
   ]
