    "plt.figure(figsize=(10,5))\n",
    "plt.plot(test.index, test['High'], label= 'AAPL')\n",
    "plt.plot(test.index, test['ema10'], label= 'EMA 10')\n",
    "plt.plot(test.index, test['ema20'], label= 'EMA 20')\n",
    "plt.plot(test.index, test['ema200'], label= 'EMA 200')\n",
    "plt.legend()\n",
